<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#17243B"
            android:backgroundTint="#E1E7F0"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="All Rental Categories"
            android:textColor="#17243B"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Choose what you want to rent."
            android:textColor="#64748B"
            android:textSize="15sp"/>

        <Button
            android:id="@+id/btnCars"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginTop="20dp"
            android:text="🚗  Cars"
            android:textSize="19sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"/>

        <Button
            android:id="@+id/btnMobiles"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginTop="12dp"
            android:text="📱  Mobile Phones"
            android:textSize="19sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0F766E"/>

        <Button
            android:id="@+id/btnCameras"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginTop="12dp"
            android:text="📷  Cameras"
            android:textSize="19sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#9333EA"/>

        <Button
            android:id="@+id/btnLaptops"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginTop="12dp"
            android:text="💻  Laptops"
            android:textSize="19sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#EA580C"/>

    </LinearLayout>
</ScrollView>